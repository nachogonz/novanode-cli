#!/usr/bin/env bash
# NovaNode Telephony DevKit — main entry.
set -u

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
PYTHON="${NOVANODE_PYTHON:-python3}"

exec "$PYTHON" "$SCRIPT_DIR/lib/main.py" "$@"
