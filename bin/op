#!/usr/bin/env bash
# Fast alias for `nn-op`.
# Same shape as `usage` → `nn-usage`. `op` with no args opens the Textual
# dashboard; `op --help` prints nn-op's help; any other args are forwarded
# to the nn-op CLI. nn-op's internal calls to the real 1Password `op` CLI
# skip this wrapper (see bin/lib/op.py:which_op), so there's no loop.
set -u

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
exec "$SCRIPT_DIR/nn-op" "$@"
